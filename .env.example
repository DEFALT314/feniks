# Skopiuj do .env.local i uzupełnij. Klucze dostajesz przez menedżer haseł, nigdy przez czat ani repo.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer: app/api/cron/, app/api/demo/, skrypty
SUPABASE_SERVICE_ROLE_KEY=

# LLM przez Hugging Face Inference Providers (zgodny z OpenAI)
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_API_KEY=

# Prywatny Space z embeddingami (sdadas/mmlw-e5-small)
EMBED_URL=
EMBED_TOKEN=

# E-mail
RESEND_API_KEY=
# SMTP for app e-mails (preferred over Resend): a Gmail account with an app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender override, e.g. HubMI.pl <powiadomienia@hubmi.pl>
EMAIL_FROM=

# Tryb demonstracyjny: ekran „Wejdź jako…” i konta demo
DEMO_MODE=true
